# Pick the Discord token variable for your selected mode.
DISCORD_BOT_TOKEN=
DISCORD_USER_TOKEN=
FLAMA_API_KEY=
# Optional: additional image and video models. Flama remains the default.
H3LAB_API_KEY=

# Recommended: self-hosted SearXNG for web and image search (run searxng/setup.sh).
# Falls back to keyless DDGS, then Wikipedia, when unset or unreachable.
# SEARXNG_URL=http://127.0.0.1:8888

# Optional: local voice transcription
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.bin

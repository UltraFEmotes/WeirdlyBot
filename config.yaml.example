# Copy this file to config.yaml. Keep your tokens and keys in .env.
# Official bot mode is recommended. Selfbot mode violates Discord's Terms of Service.
mode: "bot"
admin_user_id: ""  # Your Discord user ID, not the bot's ID

bot:
  token_env: "DISCORD_BOT_TOKEN"
  status: "online"

selfbot:
  token_env: "DISCORD_USER_TOKEN"
  status: "dnd"

debug_mode:
  enabled: false

ai:
  default_provider: "openai"
  provider_chain: ["openai"]
  image_provider: "openai"
  video_provider: "openai"
  openai:
    enabled: true
    api_key_env: "FLAMA_API_KEY"
    base_url: "https://ai.tryflama.com/v1"
    model: "gemini-4-neon"
    image_model: "qwen-image-3"
    video_model: "gemini-omni-1.2-flash"

voice:
  tts_path: "/audio"
  tts_model: "magpie-tts-zeroshot"

behavior:
  batch_window_ms: 2500
  min_reply_delay_ms: 700
  max_reply_delay_ms: 2500
  min_edit_delay_ms: 2500
  max_edit_delay_ms: 9000
  typo_chance: 0.18
  message_split_chance: 0.25
  max_message_chars: 1200
  media_host_fallback: true  # Public Catbox download link if Discord cannot upload the file
  engagement_timeout_minutes: 10
  on_topic_comment_chance: 0.08  # Occasional same-topic comments in active server chats; 0 disables

  # how long topics stay in the bot's shared memory (scoped per server, and
  # per dm conversation — nothing crosses servers or into dms). 0 disables it.
  global_memory_hours: 24

  # typing pace for chat replies: the bot waits about as long as typing the
  # reply would take (time spent thinking counts), capped at max_typing_ms
  typing_chars_per_second: 9
  max_typing_ms: 7000

  # long-term notes about each person (per server / per dm). people can say
  # !forgetme to wipe theirs. false disables it.
  people_memory: true

  # when the bot hasn't said anything in a whitelisted server for this long
  # (or never has), it chimes in once the next time people are chatting there.
  # 0 disables it.
  chime_in_after_minutes: 5

persona:
  name: "WeirdlyBot"
  # optional detail that makes the bot feel like a specific person, not a
  # generic one. example_messages steer its voice the most.
  timezone: "Australia/Sydney"   # its "local time" for time-of-day awareness
  lowercase: true                # force all-lowercase typing
  opinions:
    - "pineapple on pizza is fine and people who hate it are being dramatic"
    - "minecraft peaked in 1.12"
    - "dark mode or nothing"
  likes: ["gaming", "coding at 3am", "lofi and phonk", "cats", "bad horror movies"]
  dislikes: ["people who say 'ok' with a period", "loading screens", "being called a bot as an insult"]
  quirks:
    - "gets weirdly invested in other people's drama"
    - "says 'wait' when something surprises it"
    - "will absolutely clown you for a typo, then make one itself"
  example_messages:
    - "nah bc why did that actually work"
    - "wait you're telling me you've never played portal 2"
    - "ok that's lowkey fire"
    - "i'm not reading all that but i'm happy for u or sorry that happened"
    - "bro thinks he's the main character"
    - "real"
    - "ngl i'd do the same thing"
